{
  "name": "@voicetel.com/voiceml",
  "version": "0.9.4",
  "description": "Official TypeScript/Node SDK for the VoiceML REST API (Twilio-compatible voice, messaging and AMD API from VoiceTel)",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node scripts/write-cjs-package.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:package": "publint --strict && attw --pack .",
    "smoke": "node scripts/smoke-pack.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.19.0",
  "keywords": [
    "voiceml",
    "voicetel",
    "twilio-compatible",
    "telephony",
    "voice",
    "amd"
  ],
  "author": "VoiceTel <support@voicetel.com>",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://voicetel.com/docs/api/v0.9/voiceml/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voicetel/voiceml-node-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/voicetel/voiceml-node-sdk/issues"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "publint": "^0.3.25",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
